#   We rename the import paths to match.
#
# Where in the code:
#   File: megatron/core/transformer/attention.py
#   Location: Import section
#
# Applied to Megatron-LM code_v0.17.0
#
diff --git a/megatron/core/transformer/attention.py b/megatron/core/transformer/attention.py
index ea028f9ac..970d29862 100644
--- a/megatron/core/transformer/attention.py
+++ b/megatron/core/transformer/attention.py
@@ -61,8 +61,8 @@ except ImportError:
     rearrange = None
 
 try:
-    from flash_attn_3.flash_attn_interface import _flash_attn_forward
-    from flash_attn_3.flash_attn_interface import (
+    from flash_attn_interface import _flash_attn_forward
